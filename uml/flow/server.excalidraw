      "updated": 1770969621505,
      "link": null,
      "locked": false,
      "text": "6. Read loop\nListen for incoming messages \n\n- JOIN -> log(unexpected message from user)\n             update failed req count in stats\n\n- TEXT -> echo it (write it to client.Send channel)\n              update success req count in stats\n\n- LEAVE -> RemoveUserFromRoom(userId, roomId)\n              update success req count in stats",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6. Read loop\nListen for incoming messages \n\n- JOIN -> log(unexpected message from user)\n             update failed req count in stats\n\n- TEXT -> echo it (write it to client.Send channel)\n              update success req count in stats\n\n- LEAVE -> RemoveUserFromRoom(userId, roomId)\n              update success req count in stats",
      "autoResize": true,
      "lineHeight": 1.25
    },
