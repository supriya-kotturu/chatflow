    {
      "id": "R846TW1EzclE4wNoHDaGN",
      "type": "text",
      "x": 1050.6956713179711,
      "y": -105.97830471585826,
      "width": 511.0235290527344,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 434638230,
      "version": 500,
      "versionNonce": 1347342806,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770972886760,
      "link": null,
      "locked": false,
      "text": "4. start a goroutine for each userId\n5. loop through each roomId\n   - get separate connections for each room (c)\n   - pool.GetOrCreateNewWsClient(strconv.Itoa(userId), roomId)\n6. create signal channel \n   - (msgDone) - to notify all expected messages from the server\n                    are logged\n   - (readerDone) -  to notify when the reader goroutine is done ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. start a goroutine for each userId\n5. loop through each roomId\n   - get separate connections for each room (c)\n   - pool.GetOrCreateNewWsClient(strconv.Itoa(userId), roomId)\n6. create signal channel \n   - (msgDone) - to notify all expected messages from the server\n                    are logged\n   - (readerDone) -  to notify when the reader goroutine is done ",
      "autoResize": true,
      "lineHeight": 1.25
    },
